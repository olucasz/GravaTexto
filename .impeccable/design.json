    {
      "name": "Navegação principal",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Destinos persistentes; lateral no desktop e abas no mobile.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegação principal\"><a href=\"#\" aria-current=\"page\">Hoje</a><a href=\"#\">Jornada</a><a href=\"#\">Explorar</a><a href=\"#\">Perfil</a></nav>",
      "css": ".ds-nav{font-family:Nunito,system-ui,sans-serif;display:grid;gap:7px}.ds-nav a{min-height:52px;padding:12px 15px;border-radius:14px;color:var(--muted,#58675B);text-decoration:none;font-weight:750;display:flex;align-items:center}.ds-nav a:hover{background:#E4EAD9;color:var(--ink,#203A30)}.ds-nav a[aria-current]{background:var(--surface-highlight,#E5EFCF);color:var(--brand,#245B43)}.ds-nav a:focus-visible{outline:3px solid var(--focus,#315FAD);outline-offset:4px;}@media(max-width:640px){.ds-nav{grid-template-columns:repeat(4,1fr)}.ds-nav a{padding:7px;justify-content:center;font-size:11px;min-height:58px}}"
