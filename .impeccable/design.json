      "css": ".ds-node{font-family:Nunito,system-ui,sans-serif;display:flex;gap:16px;align-items:center;text-align:left;background:transparent;border:0;padding:5px;color:var(--ink,#203A30);cursor:pointer}.ds-core{width:72px;height:72px;flex:none;border-radius:24px;background:var(--sprout,#B7D77A);display:grid;place-items:center;box-shadow:0 8px 18px #65823d38,0 4px 0 #77984D;transition:transform 180ms var(--ease-out,cubic-bezier(.2,.8,.2,1))}.ds-node small,.ds-node em{display:block;color:var(--muted,#58675B)}.ds-node em{font-style:normal;font-size:11px;font-weight:850;margin-top:5px}.ds-node:active .ds-core{transform:translateY(3px) scale(.96)}.ds-node:focus-visible{outline:3px solid var(--focus,#315FAD);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-core{transition:none}.ds-node:active .ds-core{transform:none}}"
    },
